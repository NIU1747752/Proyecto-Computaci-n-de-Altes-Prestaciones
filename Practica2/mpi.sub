#!/bin/bash
#SBATCH --job-name=nn_mpi
#SBATCH -N 1                   # Number of nodes
#SBATCH -n 12                  # Maximum number of tasks
#SBATCH --cpus-per-task=1      # Number of cores per MPI task
#SBATCH --ntasks-per-node=12   # Maximum number of tasks on each node
#SBATCH --exclusive
#SBATCH --partition=new-nodo.q

module load openmpi/4.1.1
module load gcc/13.2.1

mpicc -Ofast main.c common/common.c configuration/config.c layer/layer.c randomizer/randomizer.c initialize/initialize.c training/training.c -o exec -lm

export OMP_NUM_THREADS=1

for np in 1 2 4 6 8 12; do
    echo "--------------"
    echo "$np procesos"
    echo "--------------"
    mpirun -np $np ./exec configuration/configfile.txt
done